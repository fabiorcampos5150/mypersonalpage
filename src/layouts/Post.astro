---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const date = new Date(frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={frontmatter.title} description={frontmatter.description} current="writing">
  <article class="post">
    <p class="kicker">Writing</p>
    <h1>{frontmatter.title}</h1>
    <p class="meta">{date} · {frontmatter.readingTime}</p>
    <slot />
    <p class="meta" style="margin-top:48px"><a href={`${base}/writing/`}>← All writing</a></p>
  </article>
</Base>
